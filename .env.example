# =====================================================================
# Real-Time AI Gym Trainer — Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and adjust values for your environment.
# Never commit real secrets, tokens, or production passwords to Git.

# ---------------------------------------------------------------------
# Application & Server Settings
# ---------------------------------------------------------------------
PROJECT_NAME="Real-Time AI Gym Trainer"
VERSION="0.1.0"
ENVIRONMENT="development"             # "development" | "production" | "testing"
DEBUG=true                            # Set to false in production
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# ---------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------
# Replace with a cryptographically secure 256-bit key in production
JWT_SECRET_KEY=change-me-generate-with-python-secrets
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ---------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# PostgreSQL Credentials (used by Docker Compose and production)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="aigym"
POSTGRES_PORT=5432

# Database URL:
# - Local SQLite Dev: sqlite+aiosqlite:///./ai_gym.db
# - Local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/aigym
# - Docker Container: postgresql+asyncpg://postgres:postgres@postgres:5432/aigym
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aigym"

# Set to "true" to automatically apply Alembic migrations on container startup
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------
# AI Models & Biomechanical Classifier Settings
# ---------------------------------------------------------------------
TEMPORAL_MODEL_PATH="models/temporal_exercise_classifier.pt"
SKLEARN_MODEL_PATH="models/exercise_classifier.joblib"
MODEL_CONFIDENCE_THRESHOLD=0.60

# ---------------------------------------------------------------------
# AI Coach Provider (Ollama / Local LLM)
# ---------------------------------------------------------------------
# When using Docker Compose, set OLLAMA_BASE_URL to "http://ollama:11434"
# The system automatically engages deterministic offline coaching fallback if Ollama is unavailable.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------
# Computer Vision & Real-Time Pose Tracking
# ---------------------------------------------------------------------
POSE_DETECTION_CONFIDENCE=0.7
POSE_TRACKING_CONFIDENCE=0.7
ENABLE_ONE_EURO_FILTER=true

# ---------------------------------------------------------------------
# High-Performance Streaming & WebSocket Limits
# ---------------------------------------------------------------------
REALTIME_PROCESSING_FPS=30
FRAME_MAX_WIDTH=1280
FRAME_MAX_HEIGHT=720
WEBSOCKET_MAX_MESSAGE_SIZE=1048576

# ---------------------------------------------------------------------
# Frontend Client Configuration
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1/ws/stream"
