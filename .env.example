# Environment Configuration for Real-Time AI Gym Trainer

# Application & Server Settings
PROJECT_NAME="Real-Time AI Gym Trainer"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Authentication & Security
JWT_SECRET_KEY="replace-with-a-secure-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60


# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# PostgreSQL (Production / Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/aigym
# SQLite (Local Dev fallback): sqlite+aiosqlite:///./ai_gym.db
DATABASE_URL="sqlite+aiosqlite:///./ai_gym.db"

# AI Model & Classification Paths (Phase 6 / Phase 7)
TEMPORAL_MODEL_PATH="models/temporal_exercise_classifier.pt"
SKLEARN_MODEL_PATH="models/exercise_classifier.joblib"
MODEL_CONFIDENCE_THRESHOLD=0.60

# AI & LLM Engine Settings (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Computer Vision & Pose Settings
POSE_DETECTION_CONFIDENCE=0.7
POSE_TRACKING_CONFIDENCE=0.7
ENABLE_ONE_EURO_FILTER=true

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1/ws/stream"
